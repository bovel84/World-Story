# World Story Environment Variables
# Copy this file to .env and fill in your values

# --- LLM provider -----------------------------------------------------------
# Chiave API del provider attivo.
LLM_API_KEY=your_api_key_here

# Provider: openai-compatible | anthropic
LLM_PROVIDER=openai-compatible

# Endpoint del provider (Ollama, LM Studio, OpenRouter, vLLM, …)
LLM_BASE_URL=http://localhost:11434/v1

# Modello predefinito
LLM_MODEL=qwen2.5:14b

# --- Server -----------------------------------------------------------------
# Server port (optional, default: 8000)
PORT=8000

# SQLite database path (optional, default: ./data/world-story.db;
# used by tests to point at a temp DB)
# OPEN_PAX_DB_PATH=./data/world-story.db
