# World Story Environment Variables
# Copy this file to .env and fill in your values

# --- LLM provider -----------------------------------------------------------
# Chiave API generica per il provider attivo (consigliata).
LLM_API_KEY=your_api_key_here

# Provider: openai-compatible | anthropic | minimax (default: minimax)
# LLM_PROVIDER=openai-compatible

# Endpoint del provider (default: https://api.minimax.io/v1)
# LLM_BASE_URL=https://ollama.com/v1

# Modello predefinito (default: MiniMax-M2.5)
# LLM_MODEL=glm-5.3-flash

# --- MiniMax (fallback dedicato) --------------------------------------------
# Usata solo quando LLM_PROVIDER=minimax e LLM_API_KEY non è impostata.
# Get your key at https://platform.minimaxi.com
# MINIMAX_API_KEY=your_api_key_here
# MINIMAX_BASE_URL=https://api.minimax.io/v1

# --- Server -----------------------------------------------------------------
# Server port (optional, default: 8000)
PORT=8000

# SQLite database path (optional, default: ./data/world-story.db;
# used by tests to point at a temp DB)
# OPEN_PAX_DB_PATH=./data/world-story.db
