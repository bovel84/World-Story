{
  "name": "world-story",
  "version": "1.0.0",
  "description": "World Story — AI-Powered Alternate History Simulator",
  "scripts": {
    "start": "node scripts/start.js",
    "start:dev": "node scripts/start.js --dev",
    "build": "npm run build --workspaces && npm run build:backend",
    "build:backend": "cd backend-nest && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install --workspaces --if-present",
    "test:unit": "npm --prefix backend-nest test && cd frontend && ../node_modules/.bin/vitest run",
    "test:e2e:mock": "cd e2e && node_modules/.bin/playwright test",
    "test:a11y": "cd e2e && node_modules/.bin/playwright test --config=playwright.a11y.config.mjs",
    "test:perf": "node e2e/perf/baseline.mjs"
  },
  "workspaces": [
    "frontend",
    "backend-nest"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "esbuild": "0.21.5"
  }
}
